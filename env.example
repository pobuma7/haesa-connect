# HAESA CONNECT — Supabase environment variables
# Copy this file to .env (same folder), fill in the real values, and
# NEVER commit the real .env file — only this .example file belongs in git.

# -----------------------------------------------------------------------
# SUPABASE_URL
# Your project's API URL.
# Find it: Supabase dashboard -> Project Settings (gear icon, bottom left)
#          -> Data API -> "Project URL"
# Looks like: https://abcdefghijklmnop.supabase.co
# Safe to use in frontend code.
# -----------------------------------------------------------------------
SUPABASE_URL=

# -----------------------------------------------------------------------
# SUPABASE_ANON_KEY
# The public "anon" key — safe to ship in frontend code.
# Row Level Security (see the integration plan, Section 6) is what
# actually limits what this key can do, not secrecy.
# Find it: Project Settings -> Data API -> "Project API keys" -> anon / public
# -----------------------------------------------------------------------
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY
# !! NEVER put this in frontend code, a browser-accessible file, or any
# !! file that gets committed to the repo. It bypasses every Row Level
# !! Security policy. It is only ever used inside Supabase Edge Functions
# !! (Section 7 of the integration plan), set there as a secret via:
# !!   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<value>
# Find it: Project Settings -> Data API -> "Project API keys" -> service_role
# Phase 1 does not need this value yet — leave it blank until Phase 3.
# -----------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
